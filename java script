// ============================================================
// AI UPDATE
// ============================================================

function updateAI(character, dt) {
  if (!character.alive) return;

  const target =
    nearestOpponent(
      character,
      1000
    );

  if (!target) return;

  const distance =
    dist(character, target);

  let preferredDistance = 190;

  if (character.type === "knife") {
    preferredDistance = 90;
  }

  if (character.type === "tar") {
    preferredDistance = 125;
  }

  if (character.type === "psychic") {
    preferredDistance = 240;
  }

  if (character.type === "fire") {
    preferredDistance = 260;
  }

  // MOVE TOWARD TARGET

  if (
    distance >
    preferredDistance
  ) {
    moveTowardSmart(
      character,
      target,
      character.speed,
      dt
    );
  }

  // ATTACK

  if (character.type === "gun") {
    if (distance < 400) {
      gunAttack(
        character,
        target
      );
    }
  }

  else if (
    character.type === "psychic"
  ) {
    psychicAttack(
      character,
      target
    );
  }

  else if (
    character.type === "fire"
  ) {
    if (distance < 400) {
      fireAttack(
        character,
        target
      );
    }
  }

  else if (
    character.type === "knife"
  ) {
    if (distance < 360) {
      knifeAttack(
        character,
        target
      );
    }
  }

  else if (
    character.type === "tar"
  ) {
    tarAttack(
      character,
      target
    );
  }
}

