function updatePlayer(dt) {
  if (!player.alive) return;

  let dx =
    (keys.KeyD ? 1 : 0) -
    (keys.KeyA ? 1 : 0);

  let dy =
    (keys.KeyS ? 1 : 0) -
    (keys.KeyW ? 1 : 0);

  if (dx || dy) {
    const dir =
      normalize(dx, dy);

    moveEntity(
      player,

      dir.x *
      player.speed *
      dt,

      dir.y *
      player.speed *
      dt
    );
  }

  if (mouse.down) {
    playerTongueAttack();
  }
}

// ============================================================
// COOLDOWNS / RESPAWN
// ============================================================

function updateCharacters(dt) {
  for (const character of allCharacters) {
    character.attackCd =
      Math.max(
        0,
        character.attackCd - dt
      );

    character.specialCd =
      Math.max(
        0,
        character.specialCd - dt
      );

    character.secondaryCd =
      Math.max(
        0,
        character.secondaryCd - dt
      );

    if (!character.alive) {
      character.respawnTimer -= dt;

      if (
        character.respawnTimer <= 0
      ) {
        respawn(character);
      }
    }
  }
}

function respawn(character) {
  character.x =
    character.spawnX;

  character.y =
    character.spawnY;

  character.hp =
    character.maxHp;

  character.shield = 0;

  character.alive = true;
}

// ============================================================
// PROJECTILE UPDATE
// ============================================================

function updateProjectiles(dt) {
  for (
    let i =
      projectiles.length - 1;

    i >= 0;

    i--
  ) {
    const projectile =
      projectiles[i];

    projectile.x +=
      projectile.vx * dt;

    projectile.y +=
      projectile.vy * dt;

    projectile.life -= dt;

    if (
      projectile.life <= 0 ||
      collidesMap(projectile)
    ) {
      projectiles.splice(i, 1);
      continue;
    }

    let hit = false;

    for (const target of allCharacters) {
      if (
        !target.alive ||
        target ===
        projectile.owner ||
        target.team ===
        projectile.owner.team
      ) {
        continue;
      }

      if (
        Math.hypot(
          projectile.x -
          target.x,

          projectile.y -
          target.y
        )
        <
        projectile.r +
        target.r
      ) {
        damageCharacter(
          target,
          projectile.damage,
          projectile.owner
        );

        if (
          projectile.type ===
          "knife"
        ) {
          playSfx("knifeHit");
        }

        if (
          projectile.type ===
          "fireball"
        ) {
          effects.push({
            type: "explosion",

            x:
              projectile.x,

            y:
              projectile.y,

            timer: 0.3
          });
        }

        projectiles.splice(i, 1);

        hit = true;
        break;
      }
    }

    if (hit) continue;
  }
}

// ============================================================
// EFFECT UPDATE
// ============================================================

function updateEffects(dt) {
  for (
    let i =
      effects.length - 1;

    i >= 0;

    i--
  ) {
    effects[i].timer -= dt;

    if (
      effects[i].timer <= 0
    ) {
      effects.splice(i, 1);
    }
  }
}

