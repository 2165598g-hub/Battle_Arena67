// ============================================================
// TARGETING
// ============================================================

function opponentsOf(character) {
  return allCharacters.filter(other =>
    other.alive &&
    other !== character &&
    other.team !== character.team
  );
}

function nearestOpponent(character, maxRange = Infinity) {
  let closest = null;
  let closestDistance = maxRange;

  for (const other of opponentsOf(character)) {
    const d = dist(
      character,
      other
    );

    if (d < closestDistance) {
      closestDistance = d;
      closest = other;
    }
  }

  return closest;
}

// ============================================================
// DAMAGE
// ============================================================

function damageCharacter(target, amount, source) {
  if (!target.alive) return;

  // Never damage teammates.
  if (
    source &&
    source.team === target.team
  ) {
    return;
  }

  if (target.shield > 0) {
    const absorbed =
      Math.min(
        target.shield,
        amount
      );

    target.shield -= absorbed;
    amount -= absorbed;
  }

  if (amount <= 0) return;

  target.hp -= amount;

  playSfx("hurt", 0.4);

  effects.push({
    type: "hit",
    x: target.x,
    y: target.y,
    timer: 0.15
  });

  if (target.hp <= 0) {
    target.hp = 0;
    target.alive = false;

    target.respawnTimer = 3;

    playSfx("death", 0.5);

    effects.push({
      type: "death",
      x: target.x,
      y: target.y,
      timer: 0.6
    });
  }
}

