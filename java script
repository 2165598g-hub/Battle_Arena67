// ============================================================
// HELPERS
// ============================================================

function clamp(v, min, max) {
  return Math.max(min, Math.min(max, v));
}

function normalize(x, y) {
  const length = Math.hypot(x, y) || 1;

  return {
    x: x / length,
    y: y / length
  };
}

function dist(a, b) {
  return Math.hypot(
    a.x - b.x,
    a.y - b.y
  );
}

function pointSegmentDistance(
  px,
  py,
  x1,
  y1,
  x2,
  y2
) {
  const vx = x2 - x1;
  const vy = y2 - y1;

  const wx = px - x1;
  const wy = py - y1;

  const c1 = vx * wx + vy * wy;

  if (c1 <= 0) {
    return Math.hypot(
      px - x1,
      py - y1
    );
  }

  const c2 = vx * vx + vy * vy;

  if (c2 <= c1) {
    return Math.hypot(
      px - x2,
      py - y2
    );
  }

  const t = c1 / c2;

  const bx = x1 + t * vx;
  const by = y1 + t * vy;

  return Math.hypot(
    px - bx,
    py - by
  );
}

function circleRect(circle, rect) {
  const x = clamp(
    circle.x,
    rect.x,
    rect.x + rect.w
  );

  const y = clamp(
    circle.y,
    rect.y,
    rect.y + rect.h
  );

  return (
    Math.hypot(
      circle.x - x,
      circle.y - y
    ) < circle.r
  );
}

