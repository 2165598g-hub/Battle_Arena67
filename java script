// ============================================================
// PLAYER ATTACK — RED LIZARD
// ============================================================

function playerTongueAttack() {
  if (!player.alive) return;
  if (player.attackCd > 0) return;

  const dir = normalize(
    mouse.x - player.x,
    mouse.y - player.y
  );

  const range = 240;

  const endX =
    player.x +
    dir.x * range;

  const endY =
    player.y +
    dir.y * range;

  let target = null;
  let closestForward = Infinity;

  for (const enemy of enemies) {
    if (!enemy.alive) continue;

    const lineDistance =
      pointSegmentDistance(
        enemy.x,
        enemy.y,

        player.x,
        player.y,

        endX,
        endY
      );

    const forward =
      (
        enemy.x -
        player.x
      ) * dir.x +

      (
        enemy.y -
        player.y
      ) * dir.y;

    if (
      forward > 0 &&
      forward < range &&
      lineDistance <
      enemy.r + 16 &&
      forward < closestForward
    ) {
      closestForward = forward;
      target = enemy;
    }
  }

  effects.push({
    type: "tongue",

    x1: player.x,
    y1: player.y,

    x2:
      target
        ? target.x
        : endX,

    y2:
      target
        ? target.y
        : endY,

    timer: 0.18
  });

  playSfx("tongueGrab");

  if (target) {
    damageCharacter(
      target,
      80,
      player
    );

    const pull =
      normalize(
        player.x -
        target.x,

        player.y -
        target.y
      );

    for (let i = 0; i < 8; i++) {
      moveEntity(
        target,
        pull.x * 5,
        pull.y * 5
      );
    }
  }

  player.attackCd = 0.55;
}

// ============================================================
// PLAYER SPECIAL
// ============================================================

function useSpecial(character) {
  if (character !== player) return;

  if (
    !character.alive ||
    character.specialCd > 0
  ) {
    return;
  }

  let target = null;
  let closest = 145;

  for (const enemy of enemies) {
    if (!enemy.alive) continue;

    const d = dist(
      player,
      enemy
    );

    if (d < closest) {
      closest = d;
      target = enemy;
    }
  }

  if (target) {
    playSfx("tongueEat");

    effects.push({
      type: "tongue",

      x1: player.x,
      y1: player.y,

      x2: target.x,
      y2: target.y,

      timer: 0.3
    });

    if (
      target.hp <=
      target.maxHp * 0.3
    ) {
      damageCharacter(
        target,
        9999,
        player
      );

      player.hp = Math.min(
        player.maxHp,
        player.hp + 120
      );
    } else {
      damageCharacter(
        target,
        150,
        player
      );
    }
  }

  character.specialCd = 5;
}

