function collidesMap(entity) {
  return walls.some(w =>
    circleRect(entity, w)
  );
}

// ============================================================
// BASIC MOVEMENT
// ============================================================

function moveEntity(entity, dx, dy) {
  let moved = false;

  entity.x += dx;

  if (collidesMap(entity)) {
    entity.x -= dx;
  } else {
    moved = true;
  }

  entity.y += dy;

  if (collidesMap(entity)) {
    entity.y -= dy;
  } else {
    moved = true;
  }

  entity.x = clamp(
    entity.x,
    42 + entity.r,
    W - 42 - entity.r
  );

  entity.y = clamp(
    entity.y,
    42 + entity.r,
    H - 42 - entity.r
  );

  return moved;
}

// ============================================================
// SMART AI MOVEMENT
// ============================================================

function moveTowardSmart(entity, target, speed, dt) {
  const direct = normalize(
    target.x - entity.x,
    target.y - entity.y
  );

  const amount = speed * dt;

  // Try direct movement first.
  if (
    tryMovement(
      entity,
      direct.x * amount,
      direct.y * amount
    )
  ) {
    return;
  }

  // Try horizontal only.
  if (
    Math.abs(direct.x) > 0.05 &&
    tryMovement(
      entity,
      direct.x * amount,
      0
    )
  ) {
    return;
  }

  // Try vertical only.
  if (
    Math.abs(direct.y) > 0.05 &&
    tryMovement(
      entity,
      0,
      direct.y * amount
    )
  ) {
    return;
  }

  // Try clockwise around obstacle.
  const side1 = {
    x: -direct.y,
    y: direct.x
  };

  if (
    tryMovement(
      entity,
      side1.x * amount,
      side1.y * amount
    )
  ) {
    return;
  }

  // Try counterclockwise.
  const side2 = {
    x: direct.y,
    y: -direct.x
  };

  tryMovement(
    entity,
    side2.x * amount,
    side2.y * amount
  );
}

function tryMovement(entity, dx, dy) {
  const oldX = entity.x;
  const oldY = entity.y;

  entity.x += dx;
  entity.y += dy;

  if (collidesMap(entity)) {
    entity.x = oldX;
    entity.y = oldY;

    return false;
  }

  return true;
}

