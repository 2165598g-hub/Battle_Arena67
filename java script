// ============================================================
// CROSSHAIR
// ============================================================

function drawCrosshair() {
  ctx.strokeStyle = "#ffffff";
  ctx.lineWidth = 1;

  ctx.beginPath();

  ctx.moveTo(
    mouse.x - 9,
    mouse.y
  );

  ctx.lineTo(
    mouse.x - 3,
    mouse.y
  );

  ctx.moveTo(
    mouse.x + 3,
    mouse.y
  );

  ctx.lineTo(
    mouse.x + 9,
    mouse.y
  );

  ctx.moveTo(
    mouse.x,
    mouse.y - 9
  );

  ctx.lineTo(
    mouse.x,
    mouse.y - 3
  );

  ctx.moveTo(
    mouse.x,
    mouse.y + 3
  );

  ctx.lineTo(
    mouse.x,
    mouse.y + 9
  );

  ctx.stroke();
}

// ============================================================
// RESET
// ============================================================

function resetGame() {
  projectiles.length = 0;
  effects.length = 0;

  for (
    const character
    of allCharacters
  ) {
    character.x =
      character.spawnX;

    character.y =
      character.spawnY;

    character.hp =
      character.maxHp;

    character.alive = true;

    character.attackCd = 0;
    character.specialCd = 0;

    character.shield = 0;

    character.respawnTimer = 0;
  }
}

// ============================================================
// MAIN UPDATE
// ============================================================

function update(dt) {
  updateCharacters(dt);

  updatePlayer(dt);

  // Your allies move + fight automatically
  for (const ally of allies) {
    updateAI(
      ally,
      dt
    );
  }

  // Enemies move + fight automatically
  for (const enemy of enemies) {
    updateAI(
      enemy,
      dt
    );
  }

  updateProjectiles(dt);
  updateEffects(dt);
}

// ============================================================
// DRAW
// ============================================================

function draw() {
  drawMap();

  for (
    const character
    of allCharacters
  ) {
    drawCharacter(
      character
    );
  }

  drawProjectiles();
  drawEffects();

  drawHUD();
  drawCrosshair();
}

// ============================================================
// LOOP
// ============================================================

let last =
  performance.now();

function loop(now) {
  const dt = Math.min(
    (now - last) / 1000,
    0.033
  );

  last = now;

  update(dt);
  draw();

  requestAnimationFrame(loop);
}

requestAnimationFrame(loop);

