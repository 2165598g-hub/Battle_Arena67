// ============================================================
// CHARACTER DRAWING
// ============================================================

function drawCharacter(character) {
  if (!character.alive) return;

  const img =
    images[
      character.imageKey
    ];

  // shadow
  ctx.fillStyle =
    "rgba(0,0,0,.35)";

  ctx.beginPath();

  ctx.ellipse(
    character.x,
    character.y + 10,

    16,
    7,

    0,
    0,
    Math.PI * 2
  );

  ctx.fill();

  if (
    img &&
    img.complete &&
    img.naturalWidth
  ) {
    const size =
      character.type === "tar"
        ? 58
        : 48;

    ctx.drawImage(
      img,

      character.x -
      size / 2,

      character.y -
      size / 2,

      size,
      size
    );
  }

  else {
    // Strong color distinction when no image supplied.
    ctx.fillStyle =
      character.color;

    ctx.beginPath();

    ctx.arc(
      character.x,
      character.y,
      character.type === "tar"
        ? 20
        : 16,
      0,
      Math.PI * 2
    );

    ctx.fill();

    // Enemy marker
    if (
      character.team === "enemy"
    ) {
      ctx.strokeStyle =
        "#ff404d";

      ctx.lineWidth = 3;

      ctx.beginPath();

      ctx.arc(
        character.x,
        character.y,
        21,
        0,
        Math.PI * 2
      );

      ctx.stroke();
    }

    // Ally marker
    else if (
      character !== player
    ) {
      ctx.strokeStyle =
        "#45dff7";

      ctx.lineWidth = 2;

      ctx.beginPath();

      ctx.arc(
        character.x,
        character.y,
        21,
        0,
        Math.PI * 2
      );

      ctx.stroke();
    }

    // Lizard lips
    if (
      character.type === "lizard"
    ) {
      ctx.fillStyle =
        "#9e42b5";

      ctx.fillRect(
        character.x - 8,
        character.y - 4,
        16,
        7
      );
    }
  }

  // Player ring
  if (character === player) {
    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 2;

    ctx.beginPath();

    ctx.arc(
      character.x,
      character.y,
      25,
      0,
      Math.PI * 2
    );

    ctx.stroke();
  }

  // health background
  ctx.fillStyle = "#0b1017";

  ctx.fillRect(
    character.x - 21,
    character.y - 32,
    42,
    6
  );

  const hpPercent =
    character.hp /
    character.maxHp;

  ctx.fillStyle =
    character.team === "enemy"
      ? "#ff4f5d"
      : "#57e68b";

  ctx.fillRect(
    character.x - 20,
    character.y - 31,
    40 * hpPercent,
    4
  );

  // Enemy label
  if (
    character.team === "enemy"
  ) {
    ctx.fillStyle = "#ff8d95";
    ctx.font = "9px monospace";
    ctx.textAlign = "center";

    ctx.fillText(
      "ENEMY",
      character.x,
      character.y - 38
    );
  }
}

// ============================================================
// DRAW PROJECTILES
// ============================================================

function drawProjectiles() {
  for (
    const p of projectiles
  ) {
    if (
      p.type === "fireball"
    ) {
      ctx.fillStyle = "#ff741c";

      ctx.beginPath();

      ctx.arc(
        p.x,
        p.y,
        9,
        0,
        Math.PI * 2
      );

      ctx.fill();

      ctx.fillStyle = "#ffd653";

      ctx.beginPath();

      ctx.arc(
        p.x,
        p.y,
        4,
        0,
        Math.PI * 2
      );

      ctx.fill();
    }

    else if (
      p.type === "knife"
    ) {
      ctx.strokeStyle = "#eeeeee";
      ctx.lineWidth = 3;

      ctx.beginPath();

      ctx.moveTo(
        p.x - 7,
        p.y
      );

      ctx.lineTo(
        p.x + 7,
        p.y
      );

      ctx.stroke();
    }

    else {
      ctx.fillStyle =
        p.owner.team === "enemy"
          ? "#ff5b62"
          : "#ffe36e";

      ctx.fillRect(
        p.x - 3,
        p.y - 3,
        7,
        7
      );
    }
  }
}

// ============================================================
// DRAW EFFECTS
// ============================================================

function drawEffects() {
  for (const effect of effects) {
    if (
      effect.type === "tongue"
    ) {
      ctx.strokeStyle = "#db72a9";
      ctx.lineWidth = 9;

      ctx.beginPath();

      ctx.moveTo(
        effect.x1,
        effect.y1
      );

      ctx.lineTo(
        effect.x2,
        effect.y2
      );

      ctx.stroke();
    }

    else if (
      effect.type === "psychic"
    ) {
      ctx.strokeStyle = "#ba83ff";
      ctx.lineWidth = 5;

      ctx.beginPath();

      ctx.moveTo(
        effect.x1,
        effect.y1
      );

      ctx.lineTo(
        effect.x2,
        effect.y2
      );

      ctx.stroke();
    }

    else if (
      effect.type === "tar"
    ) {
      ctx.strokeStyle = "#020202";
      ctx.lineWidth = 15;

      ctx.beginPath();

      ctx.moveTo(
        effect.x1,
        effect.y1
      );

      ctx.lineTo(
        effect.x2,
        effect.y2
      );

      ctx.stroke();
    }

    else if (
      effect.type ===
      "explosion"
    ) {
      ctx.fillStyle =
        "rgba(255,105,15,.55)";

      ctx.beginPath();

      ctx.arc(
        effect.x,
        effect.y,
        34,
        0,
        Math.PI * 2
      );

      ctx.fill();
    }

    else if (
      effect.type === "hit"
    ) {
      ctx.strokeStyle = "#ffffff";
      ctx.lineWidth = 3;

      ctx.beginPath();

      ctx.arc(
        effect.x,
        effect.y,
        19,
        0,
        Math.PI * 2
      );

      ctx.stroke();
    }
  }
}

